{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: SVNpush commands, run events, the folder picker, and opening the WordPress.org plugin page.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:app:allow-version",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://wordpress.org/plugins/*" }]
    },
    "opener:allow-reveal-item-in-dir",
    "allow-list-projects",
    "allow-inspect-folder",
    "allow-add-project",
    "allow-update-project",
    "allow-remove-project",
    "allow-project-history",
    "allow-start-run",
    "allow-current-run",
    "allow-approve-draft",
    "allow-confirm-publish",
    "allow-cancel-run",
    "allow-resume-run",
    "allow-discard-run",
    "allow-reset-working-copy",
    "allow-vault-view",
    "allow-save-account",
    "allow-remove-account",
    "allow-test-account",
    "allow-provider-adapters",
    "allow-list-providers",
    "allow-save-provider",
    "allow-remove-provider",
    "allow-set-default-provider",
    "allow-clear-provider-attention",
    "allow-save-provider-fallback",
    "allow-test-provider",
    "allow-list-provider-models",
    "allow-provider-fleet",
    "allow-get-settings",
    "allow-save-settings",
    "allow-run-doctor",
    "allow-diagnostics",
    "allow-check-update",
    "allow-install-update"
  ]
}
